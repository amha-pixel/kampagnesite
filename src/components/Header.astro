---
---

<header>
  <a href="/" class="logo">
    <img src="/images/ui/dankort-logo.svg" alt="Dankort logo" />
  </a>
  <span class="titel">Øremærket</span>
  <button class="menu-knap" aria-label="Åbn menu" aria-expanded="false">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<nav class="menu" id="menu">
  <a href="/">Hvad er Dankort Øremærket?</a>
  <a href="/overblik">Danmarkskortet</a>
</nav>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--solsikkegul-lys);
    padding: 0.75rem 1rem;
  }

  .logo img {
    height: 48px;
    width: auto;
  }

  .titel {
    font-family: var(--font-display);
    font-size: 1.8rem;
  }

  .menu-knap {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem;
  }

  .menu-knap span {
    display: block;
    width: 28px;
    height: 3px;
    background-color: var(--sort);
    border-radius: 2px;
  }

  .menu {
    display: none;
    flex-direction: column;
    background-color: var(--solsikkegul-lys);
    padding: 1rem;
    gap: 0.75rem;
  }

  .menu.aaben {
    display: flex;
  }

  .menu a {
    color: var(--sort);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.5rem 0;
  }

  .menu a:last-child {
    border-bottom: none;
  }
</style>

<script>
    const knap = document.querySelector<HTMLButtonElement>('.menu-knap');
    const menu = document.getElementById('menu');
  
    knap?.addEventListener('click', () => {
      const erAaben = menu?.classList.toggle('aaben');
      knap.setAttribute('aria-expanded', erAaben ? 'true' : 'false');
    });
  </script>