---
import Layout from "../components/Layout.astro";
import VaerdiCard from "../components/VaerdiCard.astro";
---

<Layout title="Dankort Øremærket">

  <section class="karrusel-sektion">
    <div class="karrusel">
      <VaerdiCard billede="/images/natursteder/natur-rapsmark.webp" overskrift="Øremærket" underoverskrift="og naturen" href="/overblik#natur" />
<VaerdiCard billede="/images/natursteder/lokalmiljoe-landsby.webp" overskrift="Øremærket" underoverskrift="og lokalmiljøet" href="/overblik#lokalmiljoe" />
<VaerdiCard billede="/images/natursteder/faellesskab-badebro.webp" overskrift="Øremærket" underoverskrift="og det sociale" href="/overblik#sociale" />
<VaerdiCard billede="/images/natursteder/faellesskab-picnic.webp" overskrift="Øremærket" underoverskrift="og fællesskabet" href="/overblik#faellesskab" />
    </div>
  </section>

</Layout>

<style>
  .karrusel-sektion {
    padding: 2rem 0;
    overflow: hidden;
  }

  .karrusel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 1rem;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .karrusel::-webkit-scrollbar {
    display: none;
  }
</style>