---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../lib/supabase.js";

export async function getStaticPaths() {
  const { data, error } = await supabase.from("natursteder").select("slug");

  if (error) {
    console.log(error);
    return [];
  }

  return data.map((natursted) => ({
    params: { slug: natursted.slug },
  }));
}

const { slug } = Astro.params;

const { data, error } = await supabase.from("natursteder").select("*").eq("slug", slug).single();
---

<Layout title={data.titel}>
  <h1>{data.titel}</h1>
  <p>{data.underrubrik}</p>
  <div class="billede-wrapper">
    <img src={data.billede} alt={data.titel} />
  </div>
  <p>{data.brodtekst}</p>
  <p>{data.unik_natur}</p>
  <p>{data.dankort_hjaelper}</p>
  <p>{data.naturoplevelser}</p>
  <p>{data.natur_fakta}</p>
  <p>{data.areal}</p>
  <p>{data.oekonomi}</p>
  <p>{data.partnere}</p>
</Layout>
